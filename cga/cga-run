#!/usr/bin/env bash
#
# cga-run -- launcher for the CodeQL generic appliance (cga) skeleton.
#
# Starts every cga* fragment server plus a no-cache server for the composite page,
# then prints the URL. Each backend is launched fully detached (setsid /
# </dev/null / disown) so this script never waits on the never-terminating
# servers and can exit cleanly.
#
#   cga run start         # build (Go) + start all servers + serve the page
#   cga run stop          # stop everything started by a previous run
#   cga run status        # show which servers are up
#   cga run build         # build the Go servers only
#   cga run seed          # (re)create the session CGAST from the samples
#
# State model (CGAST):
#   Every cga* command is a JSON-in/JSON-out filter. The servers render from a
#   shared "session" CGAST that this launcher keeps at cga-tmp/session.json
#   (override via CGA_SESSION). In a .cga workflow this is the compatibility
#   copy at .cga/current.json; top-level cga commands update it from immutable
#   object-store state. serve re-reads it on every request, so low-level direct
#   updates outside a workflow, e.g.
#       s=cga-tmp/session.json; cat "$s" | cgaql/bin/cgaql select language cpp > "$s".n && mv "$s".n "$s"
#   shows up live in the page.
#
# Ports (override via env):
#   CGA_PAGE_PORT   8600   composite page
#   CGA_CGASV_PORT  8601   cgasv (header)
#   CGA_CGADL_PORT  8602   cgadl (DB library)
#   CGA_CGAQL_PORT  8603   cgaql (query library)
#   CGA_CGAMR_PORT  8604   cgamr (requestor)
#   CGA_CGAMU_PORT  8605   cgamu (usrview)
#   CGA_CGASI_PORT  8606   cgasi (sarif ingest)
#   CGA_CGAMX_PORT  8607   cgamx (cmd server -- runs cga* commands)
#   CGA_CGAEX_PORT  8608   cgaex (human/LLM exports)
set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [ -z "${CGA_WORKFLOW_ROOT:-}" ] && [ -f "$PWD/.cga/config" ]; then
    export CGA_WORKFLOW_ROOT="$PWD"
fi
cd "$SELF_DIR"

# CGA_ROOT anchors every relative CGAST path (and cga-tmp/); the Python and Go
# components both honour it. CGA_SESSION is the shared session CGAST the serve
# viewers read live.
export CGA_ROOT="$SELF_DIR"
export CGA_TMPDIR="${CGA_TMPDIR:-$SELF_DIR/cga-tmp}"
export CGA_SESSION="${CGA_SESSION:-$CGA_TMPDIR/session.json}"
export CGAST_ROOT="$CGA_ROOT"
export CGAST_TMPDIR="$CGA_TMPDIR"
export CGAST_SESSION="$CGA_SESSION"

export CGA_PAGE_PORT="${CGA_PAGE_PORT:-8600}"
export CGA_CGASV_PORT="${CGA_CGASV_PORT:-8601}"
export CGA_CGADL_PORT="${CGA_CGADL_PORT:-8602}"
export CGA_CGAQL_PORT="${CGA_CGAQL_PORT:-8603}"
export CGA_CGAMR_PORT="${CGA_CGAMR_PORT:-8604}"
export CGA_CGAMU_PORT="${CGA_CGAMU_PORT:-8605}"
export CGA_CGASI_PORT="${CGA_CGASI_PORT:-8606}"
export CGA_CGAMX_PORT="${CGA_CGAMX_PORT:-8607}"
export CGA_CGAEX_PORT="${CGA_CGAEX_PORT:-8608}"

RUN_DIR="${CGA_RUN_DIR:-$SELF_DIR/.run}"
mkdir -p "$RUN_DIR"

# name  port  command...
servers() {
    echo "cgasv  $CGA_CGASV_PORT  $SELF_DIR/cgasv/bin/cgasv serve"
    echo "cgadl  $CGA_CGADL_PORT  $SELF_DIR/cgadl/bin/cgadl serve"
    echo "cgaql  $CGA_CGAQL_PORT  $SELF_DIR/cgaql/bin/cgaql serve"
    echo "cgamr  $CGA_CGAMR_PORT  $SELF_DIR/cgamr/bin/cgamr serve"
    echo "cgamu  $CGA_CGAMU_PORT  $SELF_DIR/cgamu/bin/cgamu serve"
    echo "cgasi  $CGA_CGASI_PORT  $SELF_DIR/cgasi/bin/cgasi serve"
    echo "cgamx  $CGA_CGAMX_PORT  $SELF_DIR/cgamx/bin/cgamx cmd"
    echo "cgaex  $CGA_CGAEX_PORT  $SELF_DIR/cgaex/bin/cgaex serve"
}

log()  { printf '%s\n' "$*"; }
pidfile() { echo "$RUN_DIR/$1.pid"; }
logfile() { echo "$RUN_DIR/$1.log"; }

is_up() { curl -sf "http://127.0.0.1:$1/healthz" >/dev/null 2>&1; }

# start_detached NAME PORT CMD...
start_detached() {
    local name="$1" port="$2"; shift 2
    if is_up "$port"; then
        log "  $name already up on :$port"
        return 0
    fi
    setsid "$@" </dev/null >"$(logfile "$name")" 2>&1 &
    local pid=$!
    disown "$pid" 2>/dev/null || true
    echo "$pid" >"$(pidfile "$name")"
    local _
    for _ in $(seq 1 40); do
        if is_up "$port"; then
            log "  $name up (pid $pid) on :$port"
            return 0
        fi
        sleep 0.25
    done
    log "ERROR: $name did not come up on :$port; tail:"
    tail -10 "$(logfile "$name")" >&2 || true
    return 1
}

gen_config() {
    cat >"$SELF_DIR/web/cga-config.js" <<EOF
// cga-config.js -- generated by cga run ($(date -Is)).
window.CGA_CONFIG = {
  cgasv: "http://127.0.0.1:${CGA_CGASV_PORT}",
  cgadl: "http://127.0.0.1:${CGA_CGADL_PORT}",
  cgaql: "http://127.0.0.1:${CGA_CGAQL_PORT}",
  cgamr: "http://127.0.0.1:${CGA_CGAMR_PORT}",
  cgamu: "http://127.0.0.1:${CGA_CGAMU_PORT}",
  cgasi: "http://127.0.0.1:${CGA_CGASI_PORT}",
  cgamx: "http://127.0.0.1:${CGA_CGAMX_PORT}",
  cgaex: "http://127.0.0.1:${CGA_CGAEX_PORT}",
};
EOF
}

build_go() {
    log "--- building Go servers ---"
    ( cd "$SELF_DIR/cgasv" && go build -o bin/cgasv . ) && log "  cgasv built"
    ( cd "$SELF_DIR/cgamu" && go build -o bin/cgamu . ) && log "  cgamu built"
}

# Sample inputs used to seed the session CGAST (override via env).
CGA_SEED_METADATA="${CGA_SEED_METADATA:-$SELF_DIR/cgadl/db-collection.global/metadata.sql}"
CGA_SEED_QUERYDIR="${CGA_SEED_QUERYDIR:-$SELF_DIR/../sample-query}"

# seed_session builds an initial session CGAST from the bundled samples so the
# page has something to show. It is idempotent: an existing session is kept
# (so CLI edits survive restarts) unless 'force' is passed.
seed_session() {
    local force="${1:-}"
    mkdir -p "$CGA_TMPDIR"
    if [ -s "$CGA_SESSION" ] && [ "$force" != "force" ]; then
        log "  session kept: $CGA_SESSION"
        return 0
    fi
    log "--- seeding session CGAST ($CGA_SESSION) ---"
    local st='{}'
    if [ -e "$CGA_SEED_METADATA" ]; then
        st="$(printf '%s' "$st" | "$SELF_DIR/cgadl/bin/cgadl" getmeta "$CGA_SEED_METADATA")"
    else
        log "  (no metadata sample at $CGA_SEED_METADATA; skipping cgadl seed)"
    fi
    if [ -d "$CGA_SEED_QUERYDIR" ]; then
        st="$(printf '%s' "$st" | "$SELF_DIR/cgaql/bin/cgaql" index "$CGA_SEED_QUERYDIR")"
    else
        log "  (no query sample at $CGA_SEED_QUERYDIR; skipping cgaql seed)"
    fi
    printf '%s\n' "$st" >"$CGA_SESSION"
    log "  session written"
}

start_page() {
    # Dashboard server for the composite page (its own detached process).
    # Disable caching so generated configuration and UI changes are visible
    # after an ordinary reload rather than requiring a hard refresh.
    if is_page_up; then
        log "  page already up on :$CGA_PAGE_PORT"
        return 0
    fi
    setsid python3 "$SELF_DIR/cga-view/cgaview/static_server.py" \
        --port "$CGA_PAGE_PORT" --directory "$SELF_DIR/web" \
        </dev/null >"$(logfile page)" 2>&1 &
    local pid=$!
    disown "$pid" 2>/dev/null || true
    echo "$pid" >"$(pidfile page)"
    local _
    for _ in $(seq 1 40); do
        if is_page_up; then
            log "  page up (pid $pid) on :$CGA_PAGE_PORT"
            return 0
        fi
        sleep 0.25
    done
    log "ERROR: page server did not come up on :$CGA_PAGE_PORT"
    return 1
}
is_page_up() { curl -sf "http://127.0.0.1:$CGA_PAGE_PORT/index.html" >/dev/null 2>&1; }

cmd_start() {
    build_go
    seed_session
    gen_config
    log "--- starting cga* fragment servers ---"
    local name port
    while read -r name port cmd; do
        # shellcheck disable=SC2086
        start_detached "$name" "$port" $cmd
    done < <(servers)
    log "--- starting composite page ---"
    start_page
    log ""
    log "cga is up:  http://127.0.0.1:${CGA_PAGE_PORT}/"
    log "stop with:  cga run stop"
}

cmd_stop() {
    log "--- stopping cga ---"
    local f name pid
    for f in "$RUN_DIR"/*.pid; do
        [ -e "$f" ] || continue
        name="$(basename "$f" .pid)"
        pid="$(cat "$f" 2>/dev/null || true)"
        if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
            kill "$pid" 2>/dev/null && log "  stopped $name (pid $pid)"
        fi
        rm -f "$f"
    done
    log "done."
}

cmd_status() {
    local name port
    while read -r name port _; do
        if is_up "$port"; then log "  $name  :$port  UP"; else log "  $name  :$port  down"; fi
    done < <(servers)
    if is_page_up; then log "  page   :$CGA_PAGE_PORT  UP"; else log "  page   :$CGA_PAGE_PORT  down"; fi
}

case "${1:-start}" in
    start|all) cmd_start ;;
    stop)      cmd_stop ;;
    status)    cmd_status ;;
    build)     build_go ;;
    seed)      seed_session force ;;
    *) echo "usage: cga run [start|stop|status|build|seed]" >&2; exit 2 ;;
esac

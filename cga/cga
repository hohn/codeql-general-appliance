}

# _lookup <token> -> spec line whose short or long field matches; nonzero if none.
_lookup() {
    local tok="$1"
    _spec | awk -v t="$tok" '$1==t || $2==t {print; found=1} END{exit !found}'
}

_all_tokens() { _spec | awk '{print $1; if ($1!=$2) print $2}'; }
_subs() {
    local row
    if row="$(_lookup "$1")"; then
        printf '%s\n' "$row" | awk '{for(i=4;i<=NF;i++) print $i}'
    else
        PYTHONPATH="$COLL/cgalib" python3 -c \
            'import sys; from tutorial_help import BY_NAME
if sys.argv[1] not in BY_NAME:
    raise SystemExit(1)
print(" ".join(name for name, title in BY_NAME[sys.argv[1]].chapters))' "$1"
    fi
}
_long()       { _lookup "$1" | awk '{print $2}'; }

usage() {
    python3 "$COLL/cgalib/dispatcher_help.py" "" "$@"
}

cmd_serve() {
    local action="${1:-start}"
    case "$action" in
        start|stop|status)
            exec python3 "$COLL/cgalib/viewers.py" "$@"
            ;;
        seed)
            "$COLL/cga-run" "$action"
            "$COLL/cga-prep-run" "$action"
            ;;
        build)   "$COLL/cga-run" build ;;      # only the analysis side builds Go
        outputs) "$COLL/cga-prep-run" outputs ;;
        *) echo "usage: cga serve [start|stop|status|build|seed|outputs]" >&2; return 2 ;;
    esac
}

cmd_run() {
    local action="${1:-start}"
    case "$action" in
        -h|--help|help)
            echo "usage: cga run [start|stop|status|build|seed]"
            return 0
            ;;
        start|stop|status|build|seed)
            exec "$COLL/cga-run" "$action" "${@:2}"
            ;;
        *)
            echo "usage: cga run [start|stop|status|build|seed]" >&2
            return 2
            ;;
    esac
}

cmd_view() {
    exec "$COLL/cga-view/bin/cga-view" "$@"
}

cmd_unified_view() {
    local action="${1:-start}"
    case "$action" in
        start|stop|status)
            exec "$COLL/cga-uv-run" "$@"
            ;;
        outline|search)
            exec "$COLL/cgauv/bin/cgauv" "$@"
            ;;
        -h|--help|help)
            cat <<'EOF'
usage: cga uv [start|stop|status]
       cga uv outline [--format markdown|json] [--detail summary|steps]
       cga uv search [QUERY] [--match-tag TAG] [--kind KIND]
EOF
            ;;
        *)
            echo "cga uv: unknown command '$action'" >&2
            return 2
            ;;
    esac
}

db_usage() {
    python3 "$COLL/cgalib/dispatcher_help.py" db
}

workflow_exists() {
    [ "${CGA_WORKFLOW_ACTIVE:-0}" != 1 ] || return 1
    if [ -n "${CGA_DIR:-}" ]; then
        [ -f "$CGA_DIR/config" ]
        return
    fi
    local probe="$PWD"
    while [ "$probe" != / ] && [ ! -f "$probe/.cga/config" ]; do
        probe="$(dirname "$probe")"
    done
    [ -f "$probe/.cga/config" ]
}

CGA_COMMON_TAGS=()
CGA_CLEAN_ARGS=()

extract_common_tags() {
    CGA_CLEAN_ARGS=()
    local scan=1
    while [ "$#" -gt 0 ]; do
        if [ "$scan" -eq 0 ]; then
            CGA_CLEAN_ARGS+=("$1")
            shift
            continue
        fi
        case "$1" in
            --)
                scan=0
                CGA_CLEAN_ARGS+=("$1")
                shift
                ;;
            --tag)
                [ "$#" -ge 2 ] || {
                    echo "cga: --tag requires a value" >&2
                    return 2
                }
                CGA_COMMON_TAGS+=("$2")
                shift 2
                ;;
            --tag=*)
                CGA_COMMON_TAGS+=("${1#--tag=}")
                shift
                ;;
            *)
                CGA_CLEAN_ARGS+=("$1")
                shift
                ;;
        esac
    done
}

reject_common_tags() {
    if [ "${#CGA_COMMON_TAGS[@]}" -gt 0 ]; then
        echo "cga: --tag applies only to recorded CGAST filter commands" >&2
        return 2
    fi
}

workflow_run() {
    local display_token="$1" display_action="$2" executable="$3"
    shift 3
    local args=(run --display-token "$display_token")
    if [ -n "$display_action" ]; then
        args+=(--display-action "$display_action")
    fi
    local tag
    for tag in "${CGA_COMMON_TAGS[@]}"; do
        args+=(--tag "$tag")
    done
    args+=(--source-step "${CGA_SOURCE_STEP:-interactive}" -- "$executable" "$@")
    exec "$COLL/cgawf/bin/cgawf" "${args[@]}"
}

main() {
    local tok
    while [ "$#" -gt 0 ]; do
        case "$1" in
            -C)
                [ "$#" -ge 2 ] || {
                    echo "cga: -C requires a directory" >&2
                    return 2
                }
                cd "$2"
                shift 2
                ;;
            --cga-dir)
                [ "$#" -ge 2 ] || {
                    echo "cga: --cga-dir requires a directory" >&2
                    return 2
                }
                export CGA_DIR="$2"
                shift 2
                ;;
            --store)
                [ "$#" -ge 2 ] || {
                    echo "cga: --store requires a root" >&2
                    return 2
                }
                export CGA_OBJECT_STORE="$2"
                shift 2
                ;;
            --tag)
                [ "$#" -ge 2 ] || {
                    echo "cga: --tag requires a value" >&2
                    return 2
                }
                CGA_COMMON_TAGS+=("$2")
                shift 2
                ;;
            --tag=*) CGA_COMMON_TAGS+=("${1#--tag=}"); shift ;;
            --json) export CGA_OUTPUT_JSON=1; shift ;;
            --quiet) export CGA_QUIET=1; shift ;;
            --verbose) export CGA_VERBOSE=1; shift ;;
            *) break ;;
        esac
    done
    tok="${1:-}"
    extract_common_tags "$@" || return $?
    set -- "${CGA_CLEAN_ARGS[@]}"
    local help_requested=0 argument
    for argument in "${@:2}"; do
        case "$argument" in
            --) break ;;
            -h|--help) help_requested=1; break ;;
        esac
    done
    if [ "$help_requested" -eq 1 ] || [ "${2:-}" = help ]; then
        local help_family=""
        case "$tok" in
            run|serve) help_family="$tok" ;;
            uv|unified-view)
                case "${2:-}" in
                    outline|search) ;;
                    *) help_family=uv ;;
                esac
                ;;
            mu|user-view) help_family=mu ;;
            sv|header) help_family=sv ;;
        esac
        if [ -n "$help_family" ]; then
            reject_common_tags || return $?
            exec python3 "$COLL/cgalib/dispatcher_help.py" "$help_family" "${@:2}"
        fi
    fi
    case "$tok" in
        ""|-h|--help|-s|-hs|-sh)
            reject_common_tags || return $?
            usage "$@"
            return $?
            ;;
        h|help)
            reject_common_tags || return $?
            shift
            if [ "$#" -eq 0 ]; then usage; return 0; fi
            exec python3 "$COLL/cgalib/help_view.py" "$@"
            ;;
        a|assist)
            shift
            if [ "$help_requested" -eq 1 ]; then
                exec "$COLL/cgaassist/bin/cgaassist" "$@"
            fi
            if [ "${2:-}" = start ]; then
                reject_common_tags || return $?
                exec "$COLL/cgaassist/bin/cgaassist" "$@"
            fi
            if ! workflow_exists; then
                echo "cga assist: initialize a workflow with cga init, or use cga a q start DIRECTORY for query authoring" >&2
                return 2
            fi
            workflow_run "$tok" "" "$COLL/cgaassist/bin/cgaassist" "$@"
            ;;
        __tools) _all_tokens; return 0 ;;
        __spec) _spec; return 0 ;;
        __sample_steps)
            PYTHONPATH="$COLL/cgalib" python3 -c \
                'from sample_help import STEPS; print(" ".join(token for step in STEPS for token in (step.number, step.name)))'
            return 0
            ;;
        __subs)  shift; _subs "${1:-}"; return 0 ;;
        __long)  shift; _long "${1:-}"; return 0 ;;
        run)     reject_common_tags || return $?; shift; cmd_run "$@"; return $? ;;
        view)    reject_common_tags || return $?; shift; cmd_view "$@"; return $? ;;
        uv|unified-view)
            reject_common_tags || return $?
            reject_common_tags || return $?
            shift
            cmd_unified_view "$@"
            return $?
            ;;
        serve)   reject_common_tags || return $?; shift; cmd_serve "$@"; return $? ;;
        gateway)
            reject_common_tags || return $?
            shift
            exec python3 "$COLL/cgalib/gateway.py" "$@"
            ;;
        public-html)
            reject_common_tags || return $?
            shift
            exec python3 "$COLL/cgalib/public_html.py" "$@"
            ;;
        github.io)
            reject_common_tags || return $?
            shift
            exec python3 "$COLL/cgalib/github_io.py" "$@"
            ;;
        llm)
            reject_common_tags || return $?
            shift
            exec python3 "$COLL/cgalib/llm.py" "$@"
            ;;
        show|open|related)
            reject_common_tags || return $?
            exec python3 "$COLL/cgalib/vid.py" "$@"
            ;;
    esac
    case "$tok" in
        init|status|root|doctor|cn|chain|st|state|step|log|tree|config|store|artifact)
            reject_common_tags || return $?
            shift
            exec "$COLL/cgawf/bin/cgawf" "$tok" "$@"
            ;;
    esac
    if [ "$tok" = db ] || [ "$tok" = database ]; then
        shift
        local action="${1:-}"
        local executable
        case "$action" in
            ""|-h|--help|help) db_usage; return 0 ;;
            plan) executable="$COLL/cgadbplan/bin/cgadbplan" ;;
            build) executable="$COLL/cgadb/bin/cgadb" ;;
            zip) executable="$COLL/cgadb/bin/cgadb" ;;
            validate) executable="$COLL/cgadbvalidate/bin/cgadbvalidate" ;;
            *) echo "cga db: unknown command '$action'" >&2; db_usage; return 2 ;;
        esac
        shift
        if [ "$action" = zip ]; then
            set -- zip "$@"
        fi
        if [ "$help_requested" -eq 1 ]; then
            exec "$executable" "$@"
        fi
        if [ "${#CGA_COMMON_TAGS[@]}" -gt 0 ] && ! workflow_exists; then
            echo "cga: --tag requires an initialized .cga workflow" >&2
            return 2
        fi
        if workflow_exists; then
            workflow_run db "$action" "$executable" "$@"
        fi
        exec "$executable" "$@"
    fi
    local line tool control_flow=0
    if ! line="$(_lookup "$tok")"; then
        echo "cga: unknown command '$tok'" >&2
        usage
        return 2
    fi
    tool="$(awk '{print $3}' <<<"$line")"
    case "$tok" in cfg|control-flow-graph) control_flow=1 ;; esac
    shift
    if [ "$control_flow" -eq 1 ]; then
        exec "$COLL/$tool/bin/$tool" --control-flow "$@"
    fi
    local action="${1:-}"
    if [ "$help_requested" -eq 1 ]; then
        exec "$COLL/$tool/bin/$tool" "$@"
    fi
    if [ "${#CGA_COMMON_TAGS[@]}" -gt 0 ] && ! workflow_exists; then
        echo "cga: --tag requires an initialized .cga workflow" >&2
        return 2
    fi
    if [ "$tok" = bench ] && [ "$action" = stop ]; then
        exec "$COLL/$tool/bin/$tool" "$@"
    fi
    case "$tok" in
        bench|dl|db-lib|ql|query-lib|mr|mrva-request|si|sarif-ingest|ex|export|mx|local-mrva)
            case "$action" in
                ""|-h|--help|help|serve|cmd) ;;
                *)
                    if workflow_exists; then
                        workflow_run "$tok" "" "$COLL/$tool/bin/$tool" "$@"
                    fi
                    ;;
            esac
            ;;
        cv|cve|sp|src-prep|db-build|db-plan|db-validate|cat|catalog|cq|codeql|qg|query-gen|pg|postgres|ds|db-serve|ms|mrva-server)
            case "$action" in
                ""|-h|--help|help|serve) ;;
                *)
                    if workflow_exists; then
                        workflow_run "$tok" "" "$COLL/$tool/bin/$tool" "$@"
                    fi
                    ;;
            esac
            ;;
        ctl|control)
            if [ "$action" = measure ]; then
                local argument
                for argument in "$@"; do
                    if [ "$argument" = --cgast-filter ] && workflow_exists; then
                        workflow_run "$tok" "" "$COLL/$tool/bin/$tool" "$@"
                    fi
                done
            fi
            ;;
    esac
    exec "$COLL/$tool/bin/$tool" "$@"
}

main "$@"

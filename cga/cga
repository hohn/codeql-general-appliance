#!/usr/bin/env bash
# cga -- unified dispatcher for the CGA tool collection.
#
# Usage:
#   cga <tool> [subcommand] [args...]     e.g. cga catalog verify
#   cga init [directory]
#   cga chain <start|list|show|...>
#   cga db <plan|build|validate> [args...]
#   cga llm context <bench|unified> [args...]
#   cga run [start|stop|status|build|seed]
#   cga view [--capture|--export] ...
#   cga serve [start|stop|status|build|seed|outputs]
#
# Every tool has a short acronym and an explicit long name; either works.
# Tools are the per-directory binaries under this collection (cga/<tool>/bin/<tool>).
#
# Hidden helpers (used by bash completion; stable interface):
#   cga __tools           list every token (short and long)
#   cga __subs   <token>  list a tool's subcommands
#   cga __long   <token>  print the canonical long name for a token
#   cga __sample_steps   list sample 05 step numbers and names
set -euo pipefail

SELF="$(readlink -f "${BASH_SOURCE[0]}")"
COLL="$(cd "$(dirname "$SELF")" && pwd)"   # the cga/ collection directory

# Single source of truth. Fields: short long tool [subcommands...]
# 'serve' is the aggregate launcher (no bin of its own).
_spec() {
    cat <<'SPEC'

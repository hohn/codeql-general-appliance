#!/usr/bin/env bash
# Launch the CGA preparation services and web page.

set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SELF_DIR"

export CGA_PREP_ROOT="$SELF_DIR"
export CGA_PREP_TMPDIR="${CGA_PREP_TMPDIR:-$SELF_DIR/cga-prep-tmp}"
export CGA_PREP_SESSION="${CGA_PREP_SESSION:-$CGA_PREP_TMPDIR/session.json}"
export CGAST_ROOT="$CGA_PREP_ROOT"
export CGAST_TMPDIR="$CGA_PREP_TMPDIR"
export CGAST_SESSION="$CGA_PREP_SESSION"

export CGA_PREP_PAGE_PORT="${CGA_PREP_PAGE_PORT:-8500}"
export CGA_PREP_CGACV_PORT="${CGA_PREP_CGACV_PORT:-8501}"
export CGA_PREP_CGASP_PORT="${CGA_PREP_CGASP_PORT:-8502}"
export CGA_PREP_CGADB_PORT="${CGA_PREP_CGADB_PORT:-8503}"
export CGA_PREP_CGAQG_PORT="${CGA_PREP_CGAQG_PORT:-8504}"

RUN_DIR="${CGA_PREP_RUN_DIR:-$SELF_DIR/.run-prep}"
mkdir -p "$RUN_DIR"

servers() {
    echo "cgacv  $CGA_PREP_CGACV_PORT  $SELF_DIR/cgacv/bin/cgacv serve"
    echo "cgasp  $CGA_PREP_CGASP_PORT  $SELF_DIR/cgasp/bin/cgasp serve"
    echo "cgadb  $CGA_PREP_CGADB_PORT  $SELF_DIR/cgadb/bin/cgadb serve"
    echo "cgaqg  $CGA_PREP_CGAQG_PORT  $SELF_DIR/cgaqg/bin/cgaqg serve"
}

log() { printf '%s\n' "$*"; }
pidfile() { echo "$RUN_DIR/$1.pid"; }
logfile() { echo "$RUN_DIR/$1.log"; }
is_up() { curl -sf "http://127.0.0.1:$1/healthz" >/dev/null 2>&1; }
is_page_up() {
    curl -sf "http://127.0.0.1:$CGA_PREP_PAGE_PORT/index.html" >/dev/null 2>&1
}

start_detached() {
    local name="$1" port="$2"; shift 2
    if is_up "$port"; then
        log "  $name already up on :$port"
        return 0
    fi
    setsid "$@" </dev/null >"$(logfile "$name")" 2>&1 &
    local pid=$!
    disown "$pid" 2>/dev/null || true
    echo "$pid" >"$(pidfile "$name")"
    local _
    for _ in $(seq 1 40); do
        if is_up "$port"; then
            log "  $name up (pid $pid) on :$port"
            return 0
        fi
        sleep 0.25
    done
    log "ERROR: $name did not come up on :$port; tail:"
    tail -10 "$(logfile "$name")" >&2 || true
    return 1
}

gen_config() {
    cat >"$SELF_DIR/web-prep/cga-prep-config.js" <<EOF
// Generated by cga-prep-run ($(date -Is)).
window.CGA_PREP_CONFIG = {
  cgacv: "http://127.0.0.1:${CGA_PREP_CGACV_PORT}",
  cgasp: "http://127.0.0.1:${CGA_PREP_CGASP_PORT}",
  cgadb: "http://127.0.0.1:${CGA_PREP_CGADB_PORT}",
  cgaqg: "http://127.0.0.1:${CGA_PREP_CGAQG_PORT}",
};
EOF
}

CGA_PREP_SEED_CVE_SPEC="${CGA_PREP_SEED_CVE_SPEC:-$SELF_DIR/examples/cves/cve-2016-9843/spec.json}"

seed_session() {
    local force="${1:-}"
    mkdir -p "$CGA_PREP_TMPDIR"
    if [ -s "$CGA_PREP_SESSION" ] && [ "$force" != "force" ]; then
        log "  preparation session kept: $CGA_PREP_SESSION"
        return 0
    fi
    log "--- seeding preparation session ($CGA_PREP_SESSION) ---"
    local st='{}'
    if [ -f "$CGA_PREP_SEED_CVE_SPEC" ]; then
        st="$(printf '%s' "$st" \
            | "$SELF_DIR/cgacv/bin/cgacv" import "$CGA_PREP_SEED_CVE_SPEC" \
            | "$SELF_DIR/cgacv/bin/cgacv" validate \
            | "$SELF_DIR/cgacv/bin/cgacv" select \
            | "$SELF_DIR/cgacv/bin/cgacv" expand \
            | "$SELF_DIR/cgasp/bin/cgasp" plan \
            | "$SELF_DIR/cgasp/bin/cgasp" fetch --dry-run \
            | "$SELF_DIR/cgaqg/bin/cgaqg" materialize \
            | "$SELF_DIR/cgaqg/bin/cgaqg" index)"
    else
        log "  (no CVE spec at $CGA_PREP_SEED_CVE_SPEC; writing empty session)"
    fi
    printf '%s\n' "$st" >"$CGA_PREP_SESSION"
}

start_page() {
    if is_page_up; then
        log "  page already up on :$CGA_PREP_PAGE_PORT"
        return 0
    fi
    setsid python3 -m http.server "$CGA_PREP_PAGE_PORT" --bind 127.0.0.1 \
        --directory "$SELF_DIR/web-prep" </dev/null >"$(logfile page)" 2>&1 &
    local pid=$!
    disown "$pid" 2>/dev/null || true
    echo "$pid" >"$(pidfile page)"
    local _
    for _ in $(seq 1 40); do
        if is_page_up; then
            log "  page up (pid $pid) on :$CGA_PREP_PAGE_PORT"
            return 0
        fi
        sleep 0.25
    done
    log "ERROR: page server did not come up on :$CGA_PREP_PAGE_PORT"
    return 1
}

cmd_start() {
    seed_session
    gen_config
    log "--- starting cga preparation fragment servers ---"
    local name port
    while read -r name port cmd; do
        # shellcheck disable=SC2086
        start_detached "$name" "$port" $cmd
    done < <(servers)
    log "--- starting CGA preparation page ---"
    start_page
    log ""
    log "cga preparation is up:  http://127.0.0.1:${CGA_PREP_PAGE_PORT}/"
    log "stop with:   $0 stop"
}

cmd_stop() {
    log "--- stopping cga preparation ---"
    local f name pid
    for f in "$RUN_DIR"/*.pid; do
        [ -e "$f" ] || continue
        name="$(basename "$f" .pid)"
        pid="$(cat "$f" 2>/dev/null || true)"
        if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
            kill "$pid" 2>/dev/null && log "  stopped $name (pid $pid)"
        fi
        rm -f "$f"
    done
    log "done."
}

cmd_status() {
    local name port
    while read -r name port _; do
        if is_up "$port"; then log "  $name  :$port  UP"; else log "  $name  :$port  down"; fi
    done < <(servers)
    if is_page_up; then log "  page    :$CGA_PREP_PAGE_PORT  UP"; else log "  page    :$CGA_PREP_PAGE_PORT  down"; fi
}

cmd_outputs() {
    python3 - "$CGA_PREP_SESSION" "$CGA_PREP_ROOT" <<'PY'
import json
import pathlib
import sys

session = pathlib.Path(sys.argv[1])
root = pathlib.Path(sys.argv[2])
state = json.loads(session.read_text()) if session.is_file() else {}
for label, key in (
    ("database_catalog", "cgacatalog-catalog"),
    ("database_manifest", "cgacatalog-manifest"),
    ("query_directory", "cgaqg-querydir"),
):
    value = state.get(key)
    path = pathlib.Path(value).expanduser() if isinstance(value, str) else None
    if path is not None and not path.is_absolute():
        path = (root / path).resolve()
    print(f"{label}: {path if path is not None else '(not prepared)'}")
PY
}

case "${1:-start}" in
    start|all) cmd_start ;;
    stop)      cmd_stop ;;
    status)    cmd_status ;;
    seed)      seed_session force ;;
    outputs)   cmd_outputs ;;
    *) echo "usage: $0 [start|stop|status|seed|outputs]" >&2; exit 2 ;;
esac

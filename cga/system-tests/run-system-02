#!/usr/bin/env bash

# Human/LLM-in-the-loop driver for the standalone multi-agent e2e test.
#
# This is a phase-decomposed, dispatchable multi-agent e2e driver. The
# work is split into named phases (preflight, reset, stage, ...) that can
# be run one at a time or as a whole pipeline, so a human or an agent can
# step through the system interactively:
#
#   ./run-system-02 -h                     # list phases (default)
#   ./run-system-02 preflight              # check tools + Postgres + port
#   ./run-system-02 reset                  # drop tables, wipe work dir
#   ./run-system-02 all                    # full pipeline
#
# Multi-user scenario: TWO independent submissions (two sessions) that
# together reference SIX real CodeQL DBs, with overlap:
#   user1 (USER1_NAME): 3 DBs
#   user2 (USER2_NAME): 5 DBs   (two of them shared with user1)
# In --mode=standalone the server's PoolManager spawns LocalArgoClient
# worker subprocesses that claim the jobs from Postgres and analyze the
# DBs in parallel.
#
# Note on identity: in --mode=standalone the server uses the dev
# authenticator, which reads the username from the X-MRVA-User request
# header (no JWT infra locally). This harness sends that header per
# submission, so job_info.user_id is attributed to USER1_NAME / USER2_NAME
# (e.g. alice / bob). Each submission still gets its own session_id, which
# independently keeps the two runs distinct.
#
# Like the original, the pipeline deliberately LEAVES the Go server
# running and the Postgres tables populated on exit (for `query`); run
# `cleanup` when done.
#
# Linux only. Run from the system-tests/ directory. Requires: go,
# codeql >= 2.23.6, host PostgreSQL, python3 (drives CGA).

set -euo pipefail

# shellcheck source=standalone-multi-agent-lib.sh
. "$(dirname "$0")/standalone-multi-agent-lib.sh"

# State handed between separate invocations (SID, SERVER_PID, ...). Cheap
# and safe: a no-op when the state file is absent.
load_state

PACK_TGZ="${MRVA_WORK_DIR}/query-pack.tgz"

# ---- Two-user scenario -----------------------------------------------
#
# Harness-level user names. Sent as the X-MRVA-User header on each
# submission (the standalone dev authenticator trusts it), so they appear
# in job_info.user_id. Override via the environment.
USER1_NAME="${USER1_NAME:-alice}"
USER2_NAME="${USER2_NAME:-bob}"

# Each user's requested repos, named <owner>/<repo> (the submitted
# NameWithOwner). On disk the DBs live under
# $SAMPLE_DB_ROOT/<language>/<owner>/<repo>; phase_stage prepends $LANGUAGE.
# The four zipped ones are extracted on demand by phase_stage.
USER1_REPOS=(
    debian/iniparser-4.1
    debian/lua-filesystem-1.8.0
    debian/libgmpada-1.5
)
USER2_REPOS=(
    debian/lua-filesystem-1.8.0
    debian/libgmpada-1.5
    debian/libjsonparser-1.1.0
    debian/mate-terminal-1.26.0
    debian/tolua-5.2.4-0.1
)

# Union of the two users' repos (deduplicated) — what actually needs
# staging on disk, since a shared DB is served once to both sessions.
mapfile -t STAGE_REPOS < <(printf '%s\n' "${USER1_REPOS[@]}" "${USER2_REPOS[@]}" | sort -u)

# Job accounting: each session analyzes its own repos, so a shared DB
# yields one job per session. Totals drive poll/verify.
NJOBS1=${#USER1_REPOS[@]}
NJOBS2=${#USER2_REPOS[@]}
NJOBS_TOTAL=$(( NJOBS1 + NJOBS2 ))

# Record the phase that just ran, so `where` can point at the current
# step across separate invocations. Persisted in the shared state file.
_mark() {
    CURRENT_PHASE="$1"
    save_state CURRENT_PHASE "$1"
}

# ======================================================================
# Phases. Each is self-contained: it (re)derives what it needs from the
# shared lib config, the persisted state file, or the server log, so it
# works both standalone and as part of `all`.
# ======================================================================

# --- preflight: tools, Postgres, free port -----------------------------
phase_preflight() {
    echo "--- preflight ---"
    if [ -z "$CODEQL_CLI_PATH" ]; then
        echo "ERROR: codeql not found on PATH"
        exit 1
    fi
    if ! command -v lsof >/dev/null 2>&1; then
        echo "ERROR: lsof not found on PATH; port reclaim on :${PORT} would" \
             "silently no-op and leave orphan servers holding the port." >&2
        echo "       Install it (e.g. 'sudo apt-get install lsof') and retry." >&2
        exit 1
    fi
    codeql version --format=terse | sed 's/^/codeql version: /'
    go version | sed 's/^/go version: /'

    pg_ensure_running
    pg_isready -h "$POSTGRES_HOST" -p "$POSTGRES_PORT" | sed 's/^/pg_isready: /'
    pg_ensure_role_db

    # Reclaim port: kill any stale process bound to PORT.
    local stale_pids p
    stale_pids="$(lsof -ti tcp:"$PORT" 2>/dev/null || true)"
    if [ -n "$stale_pids" ]; then
        echo "killing stale processes on port ${PORT}: ${stale_pids}"
        for p in $stale_pids; do
            kill "$p" 2>/dev/null || true
        done
        sleep 1
    fi
    db_server_reclaim_port
}

# --- reset: clean slate (drop tables, wipe work dir + logs) -------------
phase_reset() {
    echo "--- reset (clean slate) ---"
    psql_mrva -q -c "
DROP TABLE IF EXISTS $(IFS=,; echo "${MRVA_TABLES[*]}") CASCADE;
DROP SEQUENCE IF EXISTS $(IFS=,; echo "${MRVA_SEQUENCES[*]}") CASCADE;
" >/dev/null

    rm -rf "$MRVA_WORK_DIR" "$MRVA_TMP_DIR"
    mkdir -p "$MRVA_ARTIFACT_DIR" "$MRVA_QLDB_DIR" "$MRVA_DB_SERVE_DIR" "$MRVA_TMP_DIR"
    echo "  dropped tables; wiped ${MRVA_WORK_DIR} and transient files"
}

# --- stage: place sample CodeQL DBs where the qldbstore expects them ----
#
# Stages the UNION of both users' repos. Repos shipped as a sibling
# <repo>.zip (rather than an unpacked directory) are extracted on demand:
# the zip holds a single top-level bundle dir which we rename to <repo>.
# The agent locates the DB inside by content (codeql-database.yml +
# src.zip), so the exact bundle dir name does not matter.
phase_stage() {
    echo "--- staging ${#STAGE_REPOS[@]} CodeQL DBs (union of both users) ---"
    local repo name owner src
    for repo in "${STAGE_REPOS[@]}"; do
        name="$(basename "$repo")"
        owner="$(dirname "$repo")"
        src="${SAMPLE_DB_ROOT}/${LANGUAGE}/${owner}/${name}"

        # Extract the zipped DB the first time we need it.
        if [ ! -d "$src" ]; then
            local zipf="${src}.zip" tmpd bundle
            if [ ! -f "$zipf" ]; then
                echo "ERROR: neither DB dir nor zip found for ${repo}" >&2
                echo "  looked for: $src  and  $zipf" >&2
                exit 1
            fi
            echo "  extracting ${zipf##*/}"
            tmpd="$(mktemp -d "${TMPDIR:-/tmp}/mrva-db.XXXXXX")"
            unzip -q "$zipf" -d "$tmpd"
            bundle="$(find "$tmpd" -mindepth 1 -maxdepth 1 -type d | head -1)"
            if [ -z "$bundle" ]; then
                echo "ERROR: ${zipf} contained no top-level dir" >&2
                rm -rf "$tmpd"; exit 1
            fi
            mv "$bundle" "$src"
            rm -rf "$tmpd"
        fi

        mkdir -p "$MRVA_DB_SERVE_DIR/${owner}/${name}"
        cga db zip --db-dir "$src" \
            --output "$MRVA_DB_SERVE_DIR/${owner}/${name}/${owner}_${name}_db.zip"
        echo "  staged ${repo}"
    done
    find "$MRVA_DB_SERVE_DIR" -name '*_db.zip' -exec ls -lh {} \;
}

# --- build: server + agent binaries ------------------------------------
phase_build() {
    echo "--- building server + agent ---"
    make -s -C ../../server-commander mrvaserver mrvaagent
}

# --- start: launch the Go server in standalone mode --------------------
#
# The server owns agent lifecycle: in --mode=standalone it wires up
# LocalArgoClient, which fork/execs MRVA_ENVSIM_AGENT_BINARY per spawned
# worker. Agent stdout/stderr is inherited, so all agent log lines land
# in $SERVER_LOG.
phase_start() {
    echo "--- starting Go server on :${PORT} (no Docker) ---"
    db_server_start
    nohup ../../server-commander/mrvaserver --mode=standalone --loglevel=info \
        --dbpath="$MRVA_QLDB_DIR" \
        ${MRVA_DBG_DUMP_SYSVIEW:+--dbg-dump-sysview} \
        > "$SERVER_LOG" 2>&1 &
    SERVER_PID=$!
    echo "$SERVER_PID" > "$SERVER_PID_FILE"
    save_state SERVER_PID "$SERVER_PID"
    # Record the dump path (if capturing) so stop/cleanup can remove it later.
    [ -n "${MRVA_DBG_DUMP_SYSVIEW:-}" ] && save_state SYSVIEW_DUMP_PATH "$SYSVIEW_DUMP_PATH"

    local _
    for _ in $(seq 1 20); do
        if curl -sf "$SERVER/" >/dev/null 2>&1; then
            break
        fi
        sleep 0.5
    done
    if ! curl -sf "$SERVER/" >/dev/null 2>&1; then
        echo "ERROR: server did not come up. Tail:"
        tail -30 "$SERVER_LOG"
        exit 1
    fi
    echo "  server up (pid ${SERVER_PID})"
}

# --- pack: build the CodeQL query pack ---------------------------------
#
# One shared query pack: both users run the same query (QUERY_PATH) in the
# same LANGUAGE, so a single pack serves both submissions. (If the two
# users ever need different queries, split this into pack1/pack2.)
phase_pack() {
    echo "--- building query pack (shared by both users) ---"
    cga_pack_query "$QUERY_PATH" "$PACK_TGZ" >> "$REQ_LOG" 2>&1
    ls -lh "$PACK_TGZ"
}

# --- submit helper: POST one SubmitMsg for a single user ---------------
#
# Args: <user-name> <state-key-for-session-id> <repo> [<repo> ...]
# The user name is sent as the X-MRVA-User header, so the server records
# it in job_info.user_id; the returned session id (persisted under $2)
# additionally distinguishes this user's run from the other's.
_submit_user() {
    local uname="$1" sid_key="$2"; shift 2
    local repos=("$@")
    echo "--- submit (${uname}): SubmitMsg with ${#repos[@]} repos ---"
    printf '    %s\n' "${repos[@]}"
    local out_json="${SUBMIT_JSON%.json}-${uname}.json"
    cga_submit "$uname" "$uname" "$LANGUAGE" "$PACK_TGZ" "$SERVER" "${repos[@]}" > "$out_json"
    cat "$out_json"; echo
    local sid
    sid="$(python3 -c "import json,sys;print(json.load(open(sys.argv[1]))['id'])" \
            "$out_json")"
    echo "${uname} session=${sid}"
    save_state "$sid_key" "$sid"
}

# --- submit1 / submit2: one submission per user ------------------------
phase_submit1() {
    _submit_user "$USER1_NAME" SID1 "${USER1_REPOS[@]}"
    echo "--- CGA pack log tail ---"
    tail -6 "$REQ_LOG"
}
phase_submit2() {
    _submit_user "$USER2_NAME" SID2 "${USER2_REPOS[@]}"
}

# --- poll: wait until ALL jobs (both users) reach a terminal state -----
phase_poll() {
    load_state
    if [ -z "${SID1:-}" ] && [ -z "${SID2:-}" ]; then
        echo "ERROR: no session ids; run 'submit1'/'submit2' first"
        exit 1
    fi
    # SQL IN-list of the sessions that were actually submitted.
    local sids=()
    [ -n "${SID1:-}" ] && sids+=("$SID1")
    [ -n "${SID2:-}" ] && sids+=("$SID2")
    local in_list; in_list="$(IFS=,; echo "${sids[*]}")"

    echo "--- polling job_status (expect ${NJOBS_TOTAL} terminal rows across sessions ${in_list}) ---"
    # common.Status values: 0=Pending 1=Queued 2=Succeeded 3=Failed.
    local deadline summary terminal
    deadline=$(( $(date +%s) + POLL_DEADLINE_SECS ))
    while true; do
        summary="$(psql_mrva -t -A -F'|' -c \
                    "SELECT status, COUNT(*) FROM job_status
                      WHERE session_id IN (${in_list}) GROUP BY status;" 2>/dev/null \
                | tr '\n' ' ')"
        terminal="$(psql_mrva -t -A -c \
                    "SELECT COUNT(*) FROM job_status
                      WHERE session_id IN (${in_list}) AND status IN (2,3);" 2>/dev/null \
                | tr -d '[:space:]')"
        echo "  $(date +%H:%M:%S) status: ${summary:-<none>} (terminal=${terminal}/${NJOBS_TOTAL})"
        if [ "${terminal:-0}" -ge "$NJOBS_TOTAL" ]; then
            echo "  -> all ${NJOBS_TOTAL} jobs reached a terminal state"
            break
        fi
        if [ "$(date +%s)" -ge "$deadline" ]; then
            echo "  -> TIMEOUT after ${POLL_DEADLINE_SECS}s"
            break
        fi
        sleep "$POLL_INTERVAL"
    done
}

# --- artifacts: list result artifacts + SARIF result counts ------------
phase_artifacts() {
    echo "--- artifacts on disk ---"
    find "$MRVA_ARTIFACT_DIR" -type f -exec ls -lh {} \;

    local repo slug rzip stmp
    for repo in "${STAGE_REPOS[@]}"; do
        slug="$(echo "$repo" | tr '/' '-')"
        rzip="$(find "$MRVA_ARTIFACT_DIR" -name "*-results-*${slug}*" -type f | head -1)"
        echo "--- SARIF summary for ${repo} ---"
        if [ -z "$rzip" ]; then
            echo "  (no result artifact found)"
            continue
        fi
        stmp="$(mktemp "${TMPDIR:-/tmp}/mrva-sarif.XXXXXX")"
        unzip -p "$rzip" results.sarif > "$stmp" 2>/dev/null
        python3 - "$stmp" <<'PY'
import json, sys
d = json.load(open(sys.argv[1]))
for r in d.get("runs", []):
    print("  result count:", len(r.get("results", [])))
PY
        rm -f "$stmp"
    done
}

# --- ingest phases (optional; NOT part of `all`) -----------------------
#
# SARIF processing is not part of MRVA core, but it fits naturally at the
# tail of a full e2e run: once jobs have produced result artifacts, we can
# collect the SARIF, turn each into a SQLite database, and roll them up
# into one DuckDB for querying. These phases are dispatchable individually
# or together via the `ingest-all` meta phase.

# --- copy_sarif: collect result SARIF into the sysview-shaped tree ------
#
# Lays the SARIF out exactly as the sysview page groups jobs:
#   $DATA_LARGE_DIR/user-<name>/session-<id>/job-<num>/<owner>-<repo>.sarif
# The authoritative (user, session, owner, repo) list and its ordering come
# from Postgres (job_info), matching sysview's ORDER BY user_id, session_id,
# repo; job-<num> is the 1-based position of the repo within its session, so
# it lines up with the "job N" columns on the page. The matching artifact is
# the zip $MRVA_ARTIFACT_DIR/mrvabucket/<session>-results-<language>-<owner>-<repo>-<sha>.
phase_copy_sarif() {
    echo "--- copy_sarif -> ${DATA_LARGE_DIR} (user-/session-/job- tree) ---"
    local bucket="$MRVA_ARTIFACT_DIR/mrvabucket"

    local rows
    rows="$(psql_mrva -t -A -F'|' -c \
              "SELECT user_id, session_id, owner, repo FROM job_info
                ORDER BY user_id, session_id, repo;" 2>/dev/null)"
    if [ -z "$rows" ]; then
        echo "  (no jobs in job_info; run the pipeline first)"
        return 0
    fi

    local prev_key="" jobnum=0 copied=0 missing=0
    local user sid owner repo key artifact dest
    while IFS='|' read -r user sid owner repo; do
        [ -n "$sid" ] || continue
        key="${user}/${sid}"
        if [ "$key" != "$prev_key" ]; then
            jobnum=0
            prev_key="$key"
        fi
        jobnum=$(( jobnum + 1 ))

        # Key format: <sid>-results-<language>-<owner>-<repo>-<sha>. The
        # language and DB SHA are not in Postgres, so glob over them.
        artifact="$(ls -1 "${bucket}/${sid}-results-"*"-${owner}-${repo}-"* 2>/dev/null | head -1 || true)"
        dest="${DATA_LARGE_DIR}/user-${user}/session-${sid}/job-${jobnum}"
        if [ ! -f "$artifact" ]; then
            echo "  MISSING artifact for ${user}/${sid} ${owner}/${repo}: ${artifact}"
            missing=$(( missing + 1 ))
            continue
        fi
        mkdir -p "$dest"
        if unzip -p "$artifact" results.sarif > "${dest}/${owner}-${repo}.sarif" 2>/dev/null; then
            echo "  ${user}/session-${sid}/job-${jobnum} <- ${owner}/${repo}"
            copied=$(( copied + 1 ))
        else
            echo "  FAILED to extract results.sarif from ${artifact}"
            rm -f "${dest}/${owner}-${repo}.sarif"
            missing=$(( missing + 1 ))
        fi
    done <<< "$rows"

    echo "  copied=${copied} missing=${missing}"
}

# --- tolite: SARIF -> per-job SQLite (srfi tolite) ---------------------
phase_tolite() {
    echo "--- tolite: srfi tolite on all SARIF under ${DATA_LARGE_DIR} ---"
    if [ ! -x "$SRFI" ]; then
        echo "ERROR: srfi not found or not executable: $SRFI" >&2
        return 1
    fi
    local sarifs=() f
    mapfile -t sarifs < <(find "$DATA_LARGE_DIR" -type f -name '*.sarif' 2>/dev/null | sort)
    if [ "${#sarifs[@]}" -eq 0 ]; then
        echo "  (no SARIF found; run copy_sarif first)"
        return 0
    fi
    local n=0
    for f in "${sarifs[@]}"; do
        "$SRFI" tolite "$f" | sed 's/^/  /'
        n=$(( n + 1 ))
    done
    echo "  converted ${n} SARIF file(s) to SQLite"
}

# --- toduck: per-job SQLite -> one cumulative DuckDB (srfi toduck) ------
phase_toduck() {
    echo "--- toduck: srfi toduck over all SQLite under ${DATA_LARGE_DIR} ---"
    if [ ! -x "$SRFI" ]; then
        echo "ERROR: srfi not found or not executable: $SRFI" >&2
        return 1
    fi
    local sqlites=()
    mapfile -t sqlites < <(find "$DATA_LARGE_DIR" -type f -name '*.sqlite' 2>/dev/null | sort)
    if [ "${#sqlites[@]}" -eq 0 ]; then
        echo "  (no SQLite found; run tolite first)"
        return 0
    fi
    "$SRFI" toduck "${DATA_LARGE_DIR}/all" "${sqlites[@]}" | sed 's/^/  /'
    echo "  DuckDB: ${DATA_LARGE_DIR}/all.duckdb"
}


#
# With two sessions a shared repo is claimed once per session, so the
# right uniqueness key is the (session_id, repo) pair, not the repo name.
# We expect exactly $NJOBS_TOTAL distinct pairs and no pair claimed twice.
phase_claims() {
    echo "--- agent claims (proves every job claimed once, no double-claim) ---"
    grep "Job claimed" "$SERVER_LOG" | sed 's/^/  /' || echo "  (no claims logged)"
    N_WORKERS="$(grep "Job claimed" "$SERVER_LOG" 2>/dev/null \
                  | grep -oE 'worker_id=[^ ]+' | sort -u | wc -l | tr -d ' ')"
    # distinct (session_id, repo) pairs actually claimed
    N_CLAIM_PAIRS="$(grep "Job claimed" "$SERVER_LOG" 2>/dev/null \
                  | grep -oE 'session_id=[^ ]+ owner=[^ ]+ repo=[^ ]+' \
                  | sort -u | wc -l | tr -d ' ')"
    N_CLAIMS="$(grep -c "Job claimed" "$SERVER_LOG" 2>/dev/null | tr -d ' ')"
    echo "  distinct workers=${N_WORKERS} distinct (session,repo) claims=${N_CLAIM_PAIRS} total claim lines=${N_CLAIMS} (expect ${NJOBS_TOTAL})"
}

# Shared error scan: print result, return 1 if real (non-benign) errors.
# mrva-project-resolver is an internal helper absent on dev
# hosts; its absence is logged but benign.
_error_check() {
    if grep -E "ERROR|panic|fatal" "$SERVER_LOG" 2>/dev/null \
         | grep -v 'mrva-project-resolver' >/dev/null; then
        echo "errors (excluding benign mrva-project-resolver):"
        grep -E "ERROR|panic|fatal" "$SERVER_LOG" \
          | grep -v 'mrva-project-resolver' | head -10
        return 1
    fi
    echo "NO ERRORS (mrva-project-resolver warnings are benign on dev hosts)"
    return 0
}

# --- logs: server (+agent) log tail + error scan -----------------------
phase_logs() {
    echo "--- server log tail ---"
    tail -25 "$SERVER_LOG"
    echo "--- errors in server log ---"
    _error_check || true
}

# --- verify: final PASS/FAIL gate --------------------------------------
phase_verify() {
    load_state
    echo "--- verify ---"

    # Sessions actually submitted.
    local sids=()
    [ -n "${SID1:-}" ] && sids+=("$SID1")
    [ -n "${SID2:-}" ] && sids+=("$SID2")
    local in_list; in_list="$(IFS=,; echo "${sids[*]:-0}")"

    # Re-derive the assertions from persisted state + the log.
    local succeeded results log_err
    succeeded="$(psql_mrva -t -A -c \
                  "SELECT COUNT(*) FROM job_status
                    WHERE session_id IN (${in_list}) AND status=2;" \
                2>/dev/null | tr -d '[:space:]')"
    # Every succeeded job must also have persisted its result reference in
    # analyze_results (what the server's GetResult reads). A mismatch means
    # the worker skipped SetResultAndStatus and the client would never see
    # the result.
    results="$(psql_mrva -t -A -c \
                  "SELECT COUNT(*) FROM analyze_results
                    WHERE session_id IN (${in_list});" \
                2>/dev/null | tr -d '[:space:]')"
    N_WORKERS="$(grep "Job claimed" "$SERVER_LOG" 2>/dev/null \
                  | grep -oE 'worker_id=[^ ]+' | sort -u | wc -l | tr -d ' ')"
    N_CLAIM_PAIRS="$(grep "Job claimed" "$SERVER_LOG" 2>/dev/null \
                  | grep -oE 'session_id=[^ ]+ owner=[^ ]+ repo=[^ ]+' \
                  | sort -u | wc -l | tr -d ' ')"
    if _error_check; then log_err=0; else log_err=1; fi

    # Identity: every job_info row for a session must carry that submitter's
    # name in user_id, proving the X-MRVA-User header flowed through the dev
    # authenticator into job_info. Guards against an UNKNOWN/empty regression.
    local u1 u2 user_ok=1
    u1="$(psql_mrva -t -A -c \
            "SELECT COALESCE(string_agg(DISTINCT user_id, ','), '') FROM job_info
              WHERE session_id = ${SID1:-0};" 2>/dev/null | tr -d '[:space:]')"
    u2="$(psql_mrva -t -A -c \
            "SELECT COALESCE(string_agg(DISTINCT user_id, ','), '') FROM job_info
              WHERE session_id = ${SID2:-0};" 2>/dev/null | tr -d '[:space:]')"
    [ "$u1" = "$USER1_NAME" ] && [ "$u2" = "$USER2_NAME" ] || user_ok=0

    # Starting-worker visibility: the pool manager must record each spawned
    # worker in pending_spawns during its startup lag. Rows are short-lived
    # (deleted on registration / pruned), so we assert against PostgreSQL's
    # cumulative insert counter (pg_stat_user_tables.n_tup_ins), which survives
    # the deletes. >= 1 proves the "starting" state was made visible this run.
    # An empty result (table absent) collapses to 0 and fails the gate.
    local spawns_observed
    spawns_observed="$(psql_mrva -t -A -c \
            "SELECT COALESCE(n_tup_ins, 0) FROM pg_stat_user_tables
              WHERE relname = 'pending_spawns';" 2>/dev/null | tr -d '[:space:]')"

    echo
    echo "sessions: ${USER1_NAME}=${SID1:-<none>} ${USER2_NAME}=${SID2:-<none>}"
    echo "identities in job_info.user_id: session ${SID1:-?}=${u1:-<none>} session ${SID2:-?}=${u2:-<none>}"
    echo "starting workers recorded in pending_spawns this run: ${spawns_observed:-0}"
    echo "server still running (pid $(cat "$SERVER_PID_FILE" 2>/dev/null)); Postgres left populated."
    echo "  inspect:      ./run-system-02 query"
    echo "  ingest SARIF: ./run-system-02 ingest-all   (copy_sarif + tolite + toduck)"
    echo "  tear down:    ./run-system-02 cleanup"

    # Gate: every job succeeded, every succeeded job persisted a result
    # row, every job claimed exactly once (distinct (session,repo) pairs ==
    # total jobs), each session's jobs are attributed to the right user, and
    # no real errors. Worker count is informational only — the demand-based
    # pool may serve many jobs with fewer workers.
    if [ "${succeeded:-0}" = "$NJOBS_TOTAL" ] \
       && [ "${results:-0}" = "$NJOBS_TOTAL" ] \
       && [ "${N_CLAIM_PAIRS:-0}" = "$NJOBS_TOTAL" ] \
       && [ "${user_ok:-0}" -eq 1 ] \
       && [ "${spawns_observed:-0}" -ge 1 ] \
       && [ "${log_err:-0}" -eq 0 ]; then
        echo "PASS: ${NJOBS_TOTAL} jobs (${USER1_NAME}:${NJOBS1}, ${USER2_NAME}:${NJOBS2}), all succeeded, ${results} results persisted, ${N_CLAIM_PAIRS} distinct claims via ${N_WORKERS} worker(s), ${spawns_observed} starting-worker(s) recorded, correct identities, no errors"
        return 0
    else
        echo "FAIL: succeeded=${succeeded}/${NJOBS_TOTAL} results=${results}/${NJOBS_TOTAL} claim_pairs=${N_CLAIM_PAIRS}/${NJOBS_TOTAL} workers=${N_WORKERS} spawns_observed=${spawns_observed} user_ok=${user_ok} (u1='${u1}' want '${USER1_NAME}', u2='${u2}' want '${USER2_NAME}') log_err=${log_err}"
        return 1
    fi
}

# --- query / cleanup: delegate to the sibling scripts ------------------
phase_query() {
    exec "$(dirname "$0")/query-standalone-multi-agent-e2e.sh"
}
phase_cleanup() {
    exec "$(dirname "$0")/cleanup-standalone-multi-agent-e2e.sh"
}

# --- stop: stop the server but keep all state --------------------------
#
# Unlike cleanup, this only terminates the running server (and the agent
# subprocesses it spawned). Postgres tables, the work dir, logs and the
# sysview dump are left in place, so you can inspect state or restart with
# `start`. Handy to halt an otherwise idle server so its --dbg-dump-sysview
# file stops growing.
phase_stop() {
    load_state
    echo "--- stopping Go server (keeping state) ---"
    local stopped=0 pid seen_pids="" stale_pids p
    for pid in "${SERVER_PID:-}" "$(cat "$SERVER_PID_FILE" 2>/dev/null || true)"; do
        [ -n "$pid" ] || continue
        case " $seen_pids " in *" $pid "*) continue ;; esac
        seen_pids="$seen_pids $pid"
        if kill -0 "$pid" 2>/dev/null; then
            kill "$pid" 2>/dev/null || true
            echo "  sent SIGTERM to server pid ${pid}"
            stopped=1
        fi
    done
    # Backstop: anything still bound to our port.
    stale_pids="$(lsof -ti tcp:"$PORT" 2>/dev/null || true)"
    if [ -n "$stale_pids" ]; then
        for p in $stale_pids; do
            kill "$p" 2>/dev/null || true
            echo "  killed process on port ${PORT}: ${p}"
            stopped=1
        done
    fi
    [ "$stopped" -eq 1 ] || echo "  (no running server found)"
    # The recorded pid is now stale; drop it but keep the rest of the state.
    rm -f "$SERVER_PID_FILE"
    db_server_stop
}

# --- where: show pipeline steps, pointing at the current one -----------
phase_where() {
    load_state
    echo "pipeline (==> current step):"
    local p mark
    for p in "${ALL_PHASES[@]}"; do
        if [ "$p" = "${CURRENT_PHASE:-}" ]; then mark="==>"; else mark="   "; fi
        printf '  %s %s\n' "$mark" "$p"
    done
    [ -n "${CURRENT_PHASE:-}" ] || echo "  (no phase run yet)"
}

# ======================================================================
# Dispatcher
# ======================================================================

# The full pipeline, in order.
ALL_PHASES=(preflight reset stage build start pack submit1 submit2 poll \
            artifacts claims logs verify)

usage() {
    cat <<USAGE
Usage: $(basename "$0") [PHASE ...]

Run the standalone multi-user e2e test one phase at a time, several
phases in sequence, or the whole pipeline. With no arguments, prints this
help; use 'all' to run the whole pipeline.

Two users submit independently (attributed via the X-MRVA-User header;
the session id also keeps them distinct):
  ${USER1_NAME}: ${NJOBS1} DBs   ${USER2_NAME}: ${NJOBS2} DBs   (DBs may overlap)

Phases (in pipeline order):
  preflight | pre      check codeql/go, ensure Postgres, free the port
  reset | clean-slate  drop mrva tables, wipe work dir + logs
  stage                stage the union of both users' CodeQL DBs (extracts zips)
  build                build mrvaserver + mrvaagent
  start                launch the Go server in --mode=standalone
  pack                 build the shared CodeQL query pack
  submit1 | s1         POST ${USER1_NAME}'s session (${NJOBS1} repos)
  submit2 | s2         POST ${USER2_NAME}'s session (${NJOBS2} repos)
  poll                 wait until all ${NJOBS_TOTAL} jobs reach a terminal state
  artifacts            list result artifacts + SARIF result counts
  claims               show per-job claims (no double-claim)
  logs                 tail the server log + scan for errors
  verify               final PASS/FAIL gate (exit code reflects result)

Ingest phases (optional; NOT part of 'all'; SARIF processing is not MRVA
core but fits at the tail of a full run). Run after artifacts exist:
  copy_sarif           collect result SARIF into ${DATA_LARGE_DIR} as
                       user-<name>/session-<id>/job-<num> (sysview-shaped)
  tolite               srfi tolite: each SARIF -> per-job SQLite
  toduck               srfi toduck: all SQLite -> one cumulative DuckDB

Meta:
  all                  run every pipeline phase above, in order
  ingest-all | ingest  run copy_sarif, tolite, toduck in order
  where | -w           show the pipeline with ==> at the current step
  query                dump Postgres state (query-*.sh)
  stop                 stop the server, keep tables/work dir/dump (restart with 'start')
  cleanup              stop server, drop tables, remove work dir (cleanup-*.sh)
  -h | --help | help   show this help

Examples:
  $(basename "$0")                 # show help
  $(basename "$0") all             # full run
  $(basename "$0") preflight       # just preflight
  $(basename "$0") start submit1 submit2 poll
  $(basename "$0") where           # which step am I on?
USAGE
}

# Map a user-facing token (with aliases) to a phase, run it, and record
# progress. Meta commands (all/query/cleanup/help/where) return early and
# are not recorded as pipeline steps.
dispatch_one() {
    local token="$1" name="" p
    case "$token" in
        preflight|pre)           name=preflight ;;
        reset|clean-slate|clean) name=reset ;;
        stage)                   name=stage ;;
        build)                   name=build ;;
        start)                   name=start ;;
        pack)                    name=pack ;;
        submit1|s1)              name=submit1 ;;
        submit2|s2)              name=submit2 ;;
        poll)                    name=poll ;;
        artifacts)               name=artifacts ;;
        claims)                  name=claims ;;
        logs)                    name=logs ;;
        verify)                  name=verify ;;
        copy_sarif|copy-sarif)   name=copy_sarif ;;
        tolite)                  name=tolite ;;
        toduck)                  name=toduck ;;
        ingest-all|ingest)       for p in copy_sarif tolite toduck; do dispatch_one "$p"; echo; done; return ;;
        query)                   phase_query; return ;;
        stop)                    phase_stop; return ;;
        cleanup)                 phase_cleanup; return ;;
        all)                     for p in "${ALL_PHASES[@]}"; do dispatch_one "$p"; echo; done; return ;;
        -h|--help|help)          usage; return ;;
        -w|--where|where)        phase_where; return ;;
        *)
            echo "unknown phase: $token" >&2
            echo "try: $(basename "$0") -h" >&2
            return 2
            ;;
    esac
    # Run the resolved phase, then mark it as the current step. reset wipes
    # the state file mid-run, so marking afterwards re-persists the pointer.
    "phase_${name}"
    _mark "$name"
}

main() {
    if [ "$#" -eq 0 ]; then
        dispatch_one help
        return
    fi
    local token
    for token in "$@"; do
        dispatch_one "$token"
    done
}

main "$@"

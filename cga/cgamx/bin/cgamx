#!/usr/bin/env python3
"""cgamx launcher (POSIX bin/ entry point).

Follows the cga* convention of a thin executable under bin/ that drives a
sibling library package. It puts the cgamx project directory (for `import
cgamx`) and the shared cga/cgalib directory (for `import cgast`) on sys.path,
then dispatches to cgamx.cli.
"""

import sys
from pathlib import Path

HERE = Path(__file__).resolve()
PROJECT_DIR = HERE.parent.parent          # cga/cgamx
CGA_ROOT = PROJECT_DIR.parent             # cga

sys.path.insert(0, str(PROJECT_DIR))              # import cgamx
sys.path.insert(0, str(CGA_ROOT / "cgalib"))      # import cgast

from cgamx.cli import main  # noqa: E402

if __name__ == "__main__":
    try:
        raise SystemExit(main(sys.argv[1:]))
    except BrokenPipeError:
        try:
            sys.stdout.close()
        except Exception:
            pass
        raise SystemExit(0)

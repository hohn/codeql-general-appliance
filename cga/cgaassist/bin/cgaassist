#!/usr/bin/env python3
import sys
from pathlib import Path

PROJECT = Path(__file__).resolve().parent.parent
COLLECTION = PROJECT.parent
sys.path[:0] = [str(PROJECT), str(COLLECTION / "cgalib"),
                str(COLLECTION / "cgawf"), str(COLLECTION / "cgadl"),
                str(COLLECTION / "cgaql"), str(COLLECTION / "cgabench"),
                str(COLLECTION / "cgasi"), str(COLLECTION / "cgauv")]

from cgaassist.cli import main

if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))

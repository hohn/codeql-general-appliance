MINIO_ROOT_USER=${MINIO_ROOT_USER-user}
MINIO_ROOT_PASSWORD=${MINIO_ROOT_PASSWORD:?Export MINIO_ROOT_PASSWORD before starting containers}
ARTIFACT_MINIO_ENDPOINT=${ARTIFACT_MINIO_ENDPOINT-artifactstore:9000}
ARTIFACT_MINIO_ID=${ARTIFACT_MINIO_ID-${MINIO_ROOT_USER}}
ARTIFACT_MINIO_SECRET=${ARTIFACT_MINIO_SECRET-${MINIO_ROOT_PASSWORD}}
QLDB_MINIO_ENDPOINT=${QLDB_MINIO_ENDPOINT-dbstore:9000}
QLDB_MINIO_ID=${QLDB_MINIO_ID-${MINIO_ROOT_USER}}
QLDB_MINIO_SECRET=${QLDB_MINIO_SECRET-${MINIO_ROOT_PASSWORD}}
